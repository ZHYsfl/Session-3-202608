{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/medical-evidence-three-track-500.schema.json",
  "title": "三赛道500题医学证据测试集",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_name",
    "version",
    "status",
    "total_expected",
    "allocation",
    "questions"
  ],
  "properties": {
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["awaiting_questions", "draft", "frozen"]
    },
    "total_expected": {
      "const": 500
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_1", "track_2", "track_3"],
      "properties": {
        "track_1": {"const": 200},
        "track_2": {"const": 150},
        "track_3": {"const": 150}
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/question"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "frozen"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "questions": {"minItems": 500, "maxItems": 500}
        }
      }
    }
  ],
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "track",
        "expected_evidence_type",
        "notes",
        "should_abstain"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q(00[1-9]|0[1-9][0-9]|[1-4][0-9]{2}|500)$"
        },
        "question": {
          "type": "string",
          "minLength": 5
        },
        "track": {
          "enum": ["track_1", "track_2", "track_3"]
        },
        "expected_evidence_type": {
          "enum": [
            "guideline",
            "systematic_review",
            "RCT",
            "observational",
            "mixed",
            "other",
            "insufficient"
          ]
        },
        "notes": {
          "type": "string"
        },
        "should_abstain": {
          "type": "boolean"
        }
      }
    }
  }
}
